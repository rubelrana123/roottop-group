# Copy to .env and fill in. On Hostinger, add the same variables in
# hPanel > Node.js > Environment variables, BEFORE building:
# NEXT_PUBLIC_* values are baked into the build.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_NEWSLETTER_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# IndexNow key: 32 hex characters. Served at /indexnow-key.txt.
# Generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=
